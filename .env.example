APP_PORT=8000
RUNTIME_ENV=dev
AGENTOS_URL=http://localhost:8000

DB_DRIVER=postgresql+psycopg
DB_USER=workflow
DB_PASS=change-me-workflow-db-password
DB_HOST=postgresdb
DB_PORT=5432
DB_DATABASE=workflow_agent
POSTGRES_PORT=5432

N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_INTERNAL_BASE_URL=http://n8n:5678
N8N_INTERNAL_API_URL=http://n8n:5678/api/v1
N8N_API_KEY=replace-with-the-api-key-created-in-n8n
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
N8N_PUBLIC_API_DISABLED=false
N8N_PUBLIC_API_SWAGGERUI_DISABLED=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_DB_USER=n8n
N8N_DB_PASS=change-me-n8n-db-password
N8N_DB_DATABASE=n8n
N8N_DB_PORT=5432
N8N_DB_SCHEMA=public

GENERIC_TIMEZONE=Africa/Casablanca
TZ=Africa/Casablanca

MODEL_PROVIDER=openrouter
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=

# Frontend VITE base URLs (Optional - fallback dynamically to browser origin/host in production)
# VITE_AGENTOS_BASE_URL=http://localhost:8000
# VITE_N8N_BASE_URL=http://localhost:5678
