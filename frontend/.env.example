# Base URL of the AgentOS API backend (Optional - defaults to window.location.origin in production, or localhost:8000 in dev)
VITE_AGENTOS_BASE_URL=http://localhost:8000

# Base URL of the N8N Editor (Optional - defaults to window.location.hostname:5678 in production, or localhost:5678 in dev)
VITE_N8N_BASE_URL=http://localhost:5678
